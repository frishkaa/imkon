# ============================================================================
# IMKON — environment configuration (copy to .env; .env is gitignored)
# ============================================================================

# --- AI provider switch -----------------------------------------------------
# "deepseek" = DEVELOPMENT only, synthetic data only. Key read from api.txt.
# "local"    = PRODUCTION. Local Qwen via Ollama/vLLM. NO data leaves the server.
# >>> Switching dev->prod is this ONE line. <<<
LLM_PROVIDER=deepseek

# DeepSeek (dev). Key is READ FROM api.txt at runtime (never hardcoded/committed).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_KEY_FILE=api.txt

# Local model (prod). Ollama serving Qwen 3.5 9B / Qwen 2.5 14B.
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:14b

# --- Database ---------------------------------------------------------------
# Dev: local Postgres via docker-compose. Prod: Postgres on Babilon (Tajikistan).
DATABASE_URL=postgresql+psycopg://imkon:imkon@localhost:5433/imkon

# --- Security ---------------------------------------------------------------
# 32-byte (256-bit) key, base64 or hex. Used for AES-256-GCM of phone + full_name.
# Generate: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY_FOR_AES256_FIELD_ENCRYPTION=
# Signing key for share tokens / sessions
SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# --- Telegram (optional; bot stays OFF if unset) ----------------------------
TELEGRAM_BOT_TOKEN=

# --- App --------------------------------------------------------------------
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supabase (unused in local-Postgres mode; kept for parity with spec) -----
SUPABASE_URL=
SUPABASE_KEY=
